# Copy to deploy/.env on the server and fill in. The real .env is never committed.

# Public address of the site. A free name that points to the server's IP works, for example
# <ip with dashes>.sslip.io  (51.170.142.2 -> 51-170-142-2.sslip.io)
DOMAIN=

# Database passwords (use long random values)
ORACLE_SYS_PASSWORD=
DB_PASSWORD=

# Signs the login tokens. At least 32 random characters.
JWT_SECRET=

# Password of the demo owner and staff accounts (10+ characters)
DEMO_PASSWORD=

# First platform admin, created on first start
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=
