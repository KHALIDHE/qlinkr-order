# Copy this file to .env and fill in real values. Never commit .env itself.

# Required. Password for the /admin tool. Choose something you can remember
# but a stranger can't guess — this is the only thing standing between the
# public internet and your restaurant data.
ADMIN_PASSWORD=change-me

# Optional. Signs the admin login session cookie. If left unset, the server
# generates one automatically on first run and stores it in .session-secret
# (gitignored) so it stays stable across restarts.
SESSION_SECRET=

# Optional. Port the server listens on. Hosts like Render/Railway set this
# for you automatically in production.
PORT=3001

# Optional. Where the JSON data file (restaurants.json) is stored. Point
# this at a persistent disk/volume in production.
DATA_DIR=./server/data
